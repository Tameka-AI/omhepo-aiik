# Default: simulated, extractive, source-cited chat. No API service is required.
# Copy this file to .env.local to configure a server-side provider.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional local Ollama example (run Ollama separately):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<an installed model that supports JSON output>
# LLM_API_KEY=

# OpenAI-compatible hosted service: use its /v1 base URL, model, and secret key.
# Never prefix provider credentials with NEXT_PUBLIC_.
# localhost refers to the server running Next.js, not a remote visitor's computer.
