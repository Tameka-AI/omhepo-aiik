{
  "name": "omhepo-aiik",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "migrate:content": "node --import tsx scripts/migrate-content.ts",
    "index": "node --import tsx scripts/build-index.ts && node --import tsx scripts/build-runtime.ts",
    "predev": "npm run index",
    "dev": "node scripts/dev-server.mjs",
    "prebuild": "npm run index",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test scripts/tests/*.test.ts",
    "verify:sources": "node --import tsx scripts/verify-sources.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
